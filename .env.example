# Development-only example values. Replace placeholders locally; do not use in production.
DATABASE_URL=postgres://your-dev-user:change-me@localhost:5432/power_iot?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=development
D6_RUNTIME_MODE=PRE_CUTOVER
# Required host-managed Ed25519 JWT key files; there is no generated/default key.
JWT_ACTIVE_KID=replace-with-active-kid
# Container path for the host-managed key mounted at /run/poweriot/secrets.
JWT_ACTIVE_PRIVATE_KEY_FILE=/run/poweriot/secrets/jwt-active-private.pem
# Optional comma-separated kid=/path/to/public.pem entries.
JWT_RETIRING_PUBLIC_KEYS=
MQTT_BROKER_URL=tls://localhost:8883
MQTT_CLIENT_ID=power-iot-backend-example
MQTT_CA_FILE=./infrastructure/mosquitto/certs/ca.crt
MQTT_USERNAME=your-dev-user
MQTT_PASSWORD=change-me
MQTT_TELEMETRY_TOPIC=device/upload/data
MQTT_COMMAND_PREFIX=device
MQTT_CONTAINER_UID=1000
MQTT_CONTAINER_GID=1000

POSTGRES_USER=your-dev-user
POSTGRES_PASSWORD=change-me
